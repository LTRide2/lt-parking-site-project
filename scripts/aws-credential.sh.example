#!/usr/bin/env bash
# Copy this file to scripts/aws-credential.sh and fill in real values, OR delete
# it and use 'aws configure' / a named profile instead — scripts/deploy.sh works
# either way. The real scripts/aws-credential.sh is gitignored so credentials are
# never committed. deploy.sh sources this file (when present), then verifies the
# credentials with 'aws sts get-caller-identity' before doing anything.

export AWS_ACCESS_KEY_ID="AKIAEXAMPLEEXAMPLE"
export AWS_SECRET_ACCESS_KEY="exampleSecretKeyDoNotCommitThisValue"
# Optional: pin the region here (otherwise us-east-1 is used).
export AWS_REGION="us-east-1"
